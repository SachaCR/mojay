{
  "name": "@mojay-dev/node",
  "version": "0.1.1",
  "description": "Topics, partitions, offsets and consumer groups in a local folder, with no server: SQLite for Kafka.",
  "keywords": [
    "kafka",
    "log",
    "queue",
    "embedded",
    "streaming",
    "consumer-groups"
  ],
  "license": "MIT OR Apache-2.0",
  "homepage": "https://mojay.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SachaCR/mojay.git",
    "directory": "bindings/node"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "napi": {
    "binaryName": "mojay",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "engines": {
    "node": ">= 18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "scripts": {
    "build": "node scripts/build.mjs --release",
    "build:debug": "node scripts/build.mjs",
    "test": "node --test 'tests/*.test.mjs'"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12"
  }
}
