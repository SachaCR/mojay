{
  "name": "mojay",
  "version": "0.1.0",
  "description": "Topics, partitions and consumer groups in a local folder, with no server: the SQLite of Kafka.",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "napi": {
    "binaryName": "mojay",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "engines": {
    "node": ">= 18"
  },
  "scripts": {
    "build": "node scripts/build.mjs --release",
    "build:debug": "node scripts/build.mjs",
    "test": "node --test 'tests/*.test.mjs'"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12"
  }
}
